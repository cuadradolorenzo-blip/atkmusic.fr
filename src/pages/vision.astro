---
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>La Vision | ATK Music — Vidéo, montage & direction créative</title>
    <meta
      name="description"
      content="La Vision — page portfolio indépendante ATK Music : vidéo, montage, formats courts et direction créative."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #050505;
        --paper: #efefef;
        --ink: #f4f4f4;
        --muted: #a7a7a7;
        --soft: #151515;
        --soft-2: #202020;
        --line: rgba(255, 255, 255, 0.16);
        --line-dark: rgba(0, 0, 0, 0.18);
        --max: 1280px;
        --pad: clamp(18px, 3.3vw, 48px);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--bg); }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-transform: uppercase;
      }

      body::selection { background: var(--ink); color: var(--bg); }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      button, input, textarea { font: inherit; }

      .page {
        width: min(var(--max), 100%);
        margin: 0 auto;
        background: var(--bg);
        border-left: 1px solid var(--line);
        border-right: 1px solid var(--line);
        overflow: hidden;
      }

      .nav {
        min-height: 74px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 22px;
        padding: 0 var(--pad);
        border-bottom: 1px solid var(--line);
        color: var(--paper);
        font-size: clamp(0.68rem, 0.95vw, 0.78rem);
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .nav__links {
        display: flex;
        gap: clamp(14px, 2vw, 32px);
      }

      .nav__links:last-child { justify-content: flex-end; }
      .nav__brand {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-family: "Archivo Black", Inter, sans-serif;
        font-size: 0.72rem;
        letter-spacing: -0.04em;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
        min-height: min(820px, calc(100vh - 74px));
        border-bottom: 1px solid var(--line);
      }

      .hero__copy {
        padding: clamp(42px, 7vw, 96px) var(--pad) var(--pad);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 42px;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.14em;
      }

      .kicker::before {
        content: "";
        width: 34px;
        height: 1px;
        background: currentColor;
      }

      .hero h1 {
        margin: 34px 0 0;
        font-family: "Archivo Black", Inter, sans-serif;
        font-size: clamp(4.2rem, 11.5vw, 10.7rem);
        line-height: 0.74;
        letter-spacing: -0.09em;
      }

      .hero h1 span { display: block; }

      .hero__bottom {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 26px;
        align-items: end;
      }

      .lead {
        max-width: 440px;
        color: #cfcfcf;
        font-size: clamp(0.9rem, 1.2vw, 1rem);
        line-height: 1.55;
        text-transform: none;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
      }

      .btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 42px;
        padding: 0 18px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        transition: background 0.18s, color 0.18s, transform 0.18s;
      }

      .btn:hover { transform: translateY(-2px); }
      .btn--light { background: var(--ink); color: var(--bg); border-color: var(--ink); }

      .hero__media {
        border-left: 1px solid var(--line);
        min-height: 100%;
        display: grid;
        grid-template-rows: 1fr auto;
        background: #0b0b0b;
      }

      .poster {
        position: relative;
        min-height: 520px;
        overflow: hidden;
        background: #111;
      }

      .media-link {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        min-height: inherit;
        color: inherit;
        cursor: pointer;
      }

      .media-link::after {
        content: "Voir le post ↗";
        position: absolute;
        left: 14px;
        bottom: 14px;
        z-index: 3;
        padding: 8px 10px;
        border: 1px solid rgba(255,255,255,0.24);
        background: rgba(0,0,0,0.52);
        backdrop-filter: blur(6px);
        color: rgba(255,255,255,0.82);
        font-size: 0.62rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.18s ease, transform 0.18s ease;
      }

      .media-link:hover::after,
      .media-link:focus-visible::after {
        opacity: 1;
        transform: translateY(0);
      }

      .media-video,
      .media-image {
        width: 100%;
        height: 100%;
        min-height: inherit;
        display: block;
        object-fit: cover;
        filter: grayscale(1) contrast(1.08);
      }

      .poster::after,
      .work-media::before,
      .portrait::after,
      .services-media::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(90deg, transparent 49.8%, rgba(255,255,255,0.08) 50%, transparent 50.2%),
          repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 9px);
        mix-blend-mode: overlay;
        opacity: 0.32;
      }

      .hero__caption {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        align-items: center;
        padding: 22px var(--pad);
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .section {
        padding: clamp(58px, 8vw, 110px) var(--pad);
        border-bottom: 1px solid var(--line);
      }

      .section--paper {
        background: var(--paper);
        color: #060606;
        border-bottom-color: rgba(0,0,0,0.18);
      }

      .section__head {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: clamp(24px, 5vw, 72px);
        align-items: start;
        margin-bottom: clamp(34px, 6vw, 72px);
      }

      .label {
        color: currentColor;
        opacity: 0.55;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.12em;
      }

      h2 {
        margin: 0;
        font-family: "Archivo Black", Inter, sans-serif;
        font-size: clamp(2.4rem, 6.2vw, 6.8rem);
        line-height: 0.82;
        letter-spacing: -0.08em;
      }

      .about-grid {
        display: grid;
        grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(22px, 4vw, 54px);
        align-items: stretch;
      }

      .portrait {
        min-height: 620px;
        position: relative;
        background: #111;
        overflow: hidden;
      }

      .about-copy {
        display: grid;
        align-content: space-between;
        gap: 38px;
        padding: 6px 0;
      }

      .manifest {
        font-family: "Archivo Black", Inter, sans-serif;
        font-size: clamp(2.6rem, 7vw, 7rem);
        line-height: 0.82;
        letter-spacing: -0.085em;
      }

      .body-text {
        max-width: 680px;
        margin: 0;
        color: currentColor;
        opacity: 0.72;
        font-size: clamp(0.98rem, 1.2vw, 1.08rem);
        line-height: 1.62;
        text-transform: none;
      }

      .works {
        padding-right: 0;
      }

      .works-row {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(230px, 24vw);
        gap: 16px;
        overflow-x: auto;
        padding: 0 var(--pad) 20px 0;
        scroll-snap-type: x mandatory;
      }

      .works-row::-webkit-scrollbar { height: 8px; }
      .works-row::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.22); }

      .work-card {
        min-height: 420px;
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid var(--line);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.01)),
          #111;
      }

      .work-media {
        flex: 1;
        min-height: 300px;
        position: relative;
        overflow: hidden;
        background: #111;
      }

      .work-title {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 14px;
        padding: 16px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.74rem;
        font-weight: 900;
        letter-spacing: 0.07em;
      }

      .services-grid {
        display: grid;
        grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(24px, 5vw, 70px);
        align-items: start;
      }

      .services-media {
        min-height: 700px;
        background: #111;
        position: relative;
        overflow: hidden;
      }

      .service-list {
        border-top: 1px solid var(--line);
      }

      .service-item {
        display: grid;
        grid-template-columns: 52px minmax(0, 1fr);
        gap: 18px;
        padding: clamp(22px, 3.2vw, 36px) 0;
        border-bottom: 1px solid var(--line);
      }

      .service-item h3 {
        margin: 0 0 14px;
        font-family: "Archivo Black", Inter, sans-serif;
        font-size: clamp(1.7rem, 3.2vw, 3.6rem);
        line-height: 0.88;
        letter-spacing: -0.07em;
      }

      .service-item .body-text { max-width: 520px; }
      .num { color: var(--muted); font-size: 0.72rem; font-weight: 900; letter-spacing: 0.12em; }

      .contact-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1.1fr);
        gap: clamp(26px, 5vw, 72px);
      }

      .contact-card {
        padding: clamp(24px, 4vw, 44px);
        background: #0f0f0f;
        border: 1px solid var(--line);
      }

      .contact-card h2 { font-size: clamp(2.6rem, 5.6vw, 6rem); }
      .contact-links { display: grid; gap: 12px; margin-top: 34px; }
      .contact-links a {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.09em;
      }

      .form {
        display: grid;
        gap: 14px;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      .field label {
        color: var(--muted);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.12em;
      }

      .input {
        width: 100%;
        border: 1px solid var(--line);
        background: #080808;
        color: var(--ink);
        padding: 18px;
        outline: none;
        border-radius: 0;
        text-transform: none;
      }

      textarea.input { min-height: 180px; resize: vertical; }
      .input:focus { border-color: rgba(255,255,255,0.46); }
      .form .btn { width: fit-content; margin-top: 8px; cursor: pointer; }

      .footer {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        padding: 24px var(--pad);
        color: var(--muted);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.1em;
      }

      @media (max-width: 900px) {
        .page { border: 0; }
        .nav {
          grid-template-columns: 1fr auto;
          min-height: 62px;
        }
        .nav__links:first-child { display: none; }
        .nav__links:last-child { gap: 14px; }
        .nav__links:last-child a:nth-child(2) { display: none; }
        .nav__brand { order: -1; }

        .hero {
          grid-template-columns: 1fr;
          min-height: auto;
        }
        .hero__media { border-left: 0; border-top: 1px solid var(--line); }
        .poster { min-height: 72vh; }
        .hero__bottom { grid-template-columns: 1fr; }
        .actions { justify-content: flex-start; }

        .section__head,
        .about-grid,
        .services-grid,
        .contact-grid {
          grid-template-columns: 1fr;
        }
        .section__head { gap: 16px; }
        .portrait, .services-media { min-height: 430px; }
        .works-row { grid-auto-columns: minmax(250px, 78vw); }
        .work-card { min-height: 390px; }
      }

      @media (max-width: 560px) {
        :root { --pad: 16px; }
        .nav { font-size: 0.62rem; }
        .hero h1 { font-size: clamp(4rem, 23vw, 7.2rem); }
        .hero__copy { padding-top: 42px; }
        .poster { min-height: 470px; }
        .hero__caption { grid-template-columns: 1fr; }
        .btn { width: 100%; }
        .actions { width: 100%; }
        .section { padding-top: 56px; padding-bottom: 56px; }
        .manifest { font-size: clamp(3.1rem, 17vw, 5.2rem); }
        .service-item { grid-template-columns: 1fr; gap: 10px; }
        .footer { grid-template-columns: 1fr; }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <nav class="nav" aria-label="Navigation de la landing">
        <div class="nav__links">
          <a href="#about">À propos</a>
          <a href="#works">Projets</a>
          <a href="#services">Services</a>
        </div>
        <a class="nav__brand" href="/vision/" aria-label="La Vision ATK">ATK</a>
        <div class="nav__links">
          <a href="https://instagram.com/lavision.atk" target="_blank" rel="noopener">Instagram</a>
          <a href="mailto:contact@atkmusic.fr">Mail</a>
        </div>
      </nav>

      <section class="hero" aria-label="Introduction">
        <div class="hero__copy">
          <div>
            <span class="kicker">La Vision / studio créatif</span>
            <h1><span>Video</span><span>Editor</span></h1>
          </div>
          <div class="hero__bottom">
            <p class="lead">
              Montage vidéo, formats courts et direction créative pour artistes, marques et projets indépendants.
              Une page à part, pensée comme un portfolio humain avant d'être une page commerciale.
            </p>
            <div class="actions">
              <a class="btn btn--light" href="#works">Voir les projets</a>
              <a class="btn" href="#contact">Contact</a>
            </div>
          </div>
        </div>
        <div class="hero__media">
          <div class="poster" aria-label="Vidéo principale Kobalt">
            <a class="media-link" href="https://www.instagram.com/reel/DUnRTR0CDAz/?igsh=M3J5YXF1Y2QzNGVm" target="_blank" rel="noopener" aria-label="Voir le reel Kobalt Tattoo">
              <video
                class="media-video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster="/media/vision/posters/hero-kobalt.jpg"
                data-lazy-video
              >
                <source src="/media/vision/videos/hero-kobalt.mp4" type="video/mp4" />
              </video>
            </a>
          </div>
          <div class="hero__caption">
            <span>Kobalt — vidéo / direction visuelle</span>
            <span>ATK Music © 2026</span>
          </div>
        </div>
      </section>

      <section id="about" class="section section--paper" aria-label="À propos">
        <div class="section__head">
          <span class="label">01 / About</span>
          <h2>Donner une forme claire aux idées, aux sons et aux images.</h2>
        </div>
        <div class="about-grid">
          <div class="portrait" aria-label="Portrait ou image studio">
            <img class="media-image" src="/media/vision/images/about.jpg" alt="Portrait / image de travail ATK Music" loading="lazy" />
          </div>
          <div class="about-copy">
            <p class="body-text">
              Mon travail commence avant le montage : comprendre ce qu'on veut faire ressentir.
              Je cherche le rythme, la tension, le détail qui rend une vidéo plus claire, plus humaine,
              plus mémorable. Pas du contenu pour remplir un feed : une présence visuelle avec une intention.
            </p>
            <p class="manifest">Ready to make your project visible?</p>
            <p class="body-text">
              On part de ta matière brute — images, son, idée, univers — puis on construit une forme :
              narration, découpage, montage, formats, variations et livraison prête à publier.
            </p>
          </div>
        </div>
      </section>

      <section id="works" class="section works" aria-label="Portfolio">
        <div class="section__head">
          <span class="label">02 / Works</span>
          <h2>Selected visual pieces.</h2>
        </div>
        <div class="works-row" aria-label="Galerie de projets">
          <article class="work-card">
            <div class="work-media">
              <a class="media-link" href="https://www.instagram.com/reel/DTxPnsLjxxt/?igsh=bHRlMm9leXhiMWcz" target="_blank" rel="noopener" aria-label="Voir le reel Sushi Pearl">
                <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-sushi-pearl.jpg" data-lazy-video>
                  <source src="/media/vision/videos/project-sushi-pearl.mp4" type="video/mp4" />
                </video>
              </a>
            </div>
            <div class="work-title"><span>01</span><span>Sushi Pearl / lieu & ambiance</span></div>
          </article>
          <article class="work-card">
            <div class="work-media">
              <a class="media-link" href="https://www.instagram.com/reel/DRg46KGDMKS/?igsh=MW11dGxwMXQ0cjdxNg==" target="_blank" rel="noopener" aria-label="Voir le reel Graffiti">
                <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-graffiti.jpg" data-lazy-video>
                  <source src="/media/vision/videos/project-graffiti.mp4" type="video/mp4" />
                </video>
              </a>
            </div>
            <div class="work-title"><span>02</span><span>Graffiti / shop & artiste</span></div>
          </article>
          <article class="work-card">
            <div class="work-media">
              <a class="media-link" href="https://vm.tiktok.com/ZGdxkVc3R/" target="_blank" rel="noopener" aria-label="Voir le TikTok musique idée texte">
                <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-music-text.jpg" data-lazy-video>
                  <source src="/media/vision/videos/project-music-text.mp4" type="video/mp4" />
                </video>
              </a>
            </div>
            <div class="work-title"><span>03</span><span>Musique / idée & texte</span></div>
          </article>
          <article class="work-card">
            <div class="work-media">
              <a class="media-link" href="https://www.instagram.com/reel/DXPECgYtlQ4/?igsh=czQ5enl1djk4bnY3" target="_blank" rel="noopener" aria-label="Voir le reel Tattoo shop recrutement">
                <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-tattoo-recruit.jpg" data-lazy-video>
                  <source src="/media/vision/videos/project-tattoo-recruit.mp4" type="video/mp4" />
                </video>
              </a>
            </div>
            <div class="work-title"><span>04</span><span>Tattoo shop / recrutement</span></div>
          </article>
          <article class="work-card">
            <div class="work-media">
              <a class="media-link" href="https://www.instagram.com/reel/DYNBgWqMoh2/?igsh=Ym8yeDk0cGxmcWtr" target="_blank" rel="noopener" aria-label="Voir le reel Défi short">
                <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-defi.jpg" data-lazy-video>
                  <source src="/media/vision/videos/project-defi.mp4" type="video/mp4" />
                </video>
              </a>
            </div>
            <div class="work-title"><span>05</span><span>Défi / short social</span></div>
          </article>
          <article class="work-card">
            <div class="work-media">
              <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-download.jpg" data-lazy-video>
                <source src="/media/vision/videos/project-download.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="work-title"><span>06</span><span>Format court / montage</span></div>
          </article>
        </div>
      </section>

      <section id="services" class="section" aria-label="Services">
        <div class="section__head">
          <span class="label">03 / Services</span>
          <h2>What I can build with you.</h2>
        </div>
        <div class="services-grid">
          <div class="services-media" aria-label="Vidéo process / montage">
            <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="/media/vision/posters/project-download.jpg" data-lazy-video>
              <source src="/media/vision/videos/project-download.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="service-list">
            <article class="service-item">
              <span class="num">01</span>
              <div>
                <h3>Montage vidéo</h3>
                <p class="body-text">Rythme, narration, coupe, son, respiration. Transformer une matière brute en vidéo claire.</p>
              </div>
            </article>
            <article class="service-item">
              <span class="num">02</span>
              <div>
                <h3>Formats courts</h3>
                <p class="body-text">Reels, TikTok, Shorts : accroche, structure, sous-titres, dynamique, déclinaisons.</p>
              </div>
            </article>
            <article class="service-item">
              <span class="num">03</span>
              <div>
                <h3>Direction créative</h3>
