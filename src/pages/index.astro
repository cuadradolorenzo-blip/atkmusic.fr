---
const target = "/lavision/";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0; url=/lavision/" />
    <link rel="canonical" href="https://atkmusic.fr/lavision/" />
    <title>Redirection vers La Vision — ATK Music</title>
    <script is:inline>
      window.location.replace('/lavision/');
    </script>
    <style>
      html, body { height: 100%; margin: 0; background: #050505; color: #f7f2ea; font-family: Arial, sans-serif; }
      body { display: grid; place-items: center; text-align: center; padding: 24px; }
      a { color: inherit; font-weight: 700; }
    </style>
  </head>
  <body>
    <main>
      <p>Redirection vers <a href="/lavision/">La Vision</a>…</p>
    </main>
  </body>
</html>
