<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="Le guide pratique pour construire ton premier home studio sans gaspiller ton budget.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://atkmusic.fr/ebook/">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="ATKMusic">
  <meta property="og:title" content="Mon Premier Home Studio — ATKMusic">
  <meta property="og:description" content="Le guide pratique pour construire ton premier home studio sans gaspiller ton budget.">
  <meta property="og:url" content="https://atkmusic.fr/ebook/">
  <meta name="twitter:card" content="summary_large_image">
  <title>Mon Premier Home Studio — ATKMusic</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f7f7fb;
      --surface: rgba(255,255,255,.86);
      --surface-solid: #ffffff;
      --text: #131118;
      --muted: #66606f;
      --line: rgba(31, 26, 38, .12);
      --purple: #7c2cff;
      --purple-2: #a060ff;
      --purple-soft: rgba(124,44,255,.10);
      --shadow: 0 28px 80px rgba(49, 24, 82, .16);
      --radius: 24px;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #09080c;
        --surface: rgba(20,18,25,.88);
        --surface-solid: #141219;
        --text: #f7f3fb;
        --muted: #b9b1c2;
        --line: rgba(255,255,255,.12);
        --purple: #9852ff;
        --purple-2: #bd8aff;
        --purple-soft: rgba(152,82,255,.15);
        --shadow: 0 32px 90px rgba(0,0,0,.45);
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% -10%, rgba(124,44,255,.18), transparent 34rem),
        radial-gradient(circle at 90% 18%, rgba(124,44,255,.10), transparent 28rem),
        var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a, button { font: inherit; }
    button { cursor: pointer; }
    a { color: inherit; }
    img { display: block; max-width: 100%; }
    .skip {
      position: absolute; left: 12px; top: -60px; z-index: 100;
      background: var(--surface-solid); color: var(--text); padding: 10px 14px;
      border-radius: 10px; border: 1px solid var(--line);
    }
    .skip:focus { top: 12px; }
    .wrap { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
    .nav {
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 22px 0 8px;
    }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 900; letter-spacing: -.03em; }
    .brand-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--purple); box-shadow: 0 0 0 7px var(--purple-soft); }
    .nav-cta {
      border: 1px solid var(--line); background: var(--surface); color: var(--text);
      padding: 10px 15px; border-radius: 999px; font-weight: 800;
    }
    .hero {
      min-height: 78vh;
      display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 72px;
      padding: 64px 0 84px;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 12px; border: 1px solid rgba(124,44,255,.24); border-radius: 999px;
      background: var(--purple-soft); color: var(--purple-2); font-weight: 900; font-size: .82rem;
      letter-spacing: .05em; text-transform: uppercase;
    }
    h1 {
      margin: 20px 0 18px; font-size: clamp(3rem, 7vw, 6.8rem); line-height: .91;
      letter-spacing: -.075em; max-width: 9ch;
    }
    .accent { color: var(--purple); }
    .lead { font-size: clamp(1.08rem, 2vw, 1.35rem); max-width: 660px; color: var(--muted); margin: 0 0 26px; }
    .bullets { display: grid; gap: 10px; margin: 0 0 30px; padding: 0; list-style: none; }
    .bullets li { display: flex; align-items: flex-start; gap: 10px; font-weight: 650; }
    .check {
      flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
      background: var(--purple-soft); color: var(--purple); font-weight: 1000; font-size: .8rem; margin-top: 1px;
    }
    .buy-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .buy {
      border: 0; min-height: 56px; padding: 0 24px; border-radius: 16px;
      background: linear-gradient(135deg, var(--purple), #6620df); color: white;
      font-weight: 950; letter-spacing: -.01em; box-shadow: 0 14px 38px rgba(124,44,255,.30);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .buy:hover { transform: translateY(-2px); box-shadow: 0 18px 46px rgba(124,44,255,.38); }
    .buy:active { transform: translateY(0); }
    .price-note { display: grid; gap: 2px; }
    .price { font-weight: 950; font-size: 1.25rem; letter-spacing: -.03em; }
    .micro { color: var(--muted); font-size: .88rem; }
    .trust { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 22px; color: var(--muted); font-size: .9rem; }
    .trust span { display: inline-flex; gap: 6px; align-items: center; }
    .book-stage { position: relative; min-height: 600px; display: grid; place-items: center; }
    .glow {
      position: absolute; inset: 12% 5%; border-radius: 50%; filter: blur(55px);
      background: radial-gradient(circle, rgba(124,44,255,.38), transparent 65%); opacity: .72;
    }
    .book {
      position: relative; width: min(410px, 86%); transform: perspective(1300px) rotateY(-8deg) rotateX(2deg);
      filter: drop-shadow(0 28px 36px rgba(0,0,0,.26));
    }
    .book::after {
      content: ""; position: absolute; inset: 0 -12px 0 auto; width: 12px; border-radius: 0 12px 12px 0;
      background: linear-gradient(90deg, #2c173f, #130a1e); transform: skewY(-2deg); transform-origin: left top;
    }
    .cover { width: 100%; border-radius: 9px 4px 4px 9px; border: 1px solid rgba(255,255,255,.14); }
    .badge {
      position: absolute; right: -22px; bottom: 8%; z-index: 3;
      background: var(--surface-solid); border: 1px solid var(--line); border-radius: 18px;
      padding: 13px 16px; box-shadow: var(--shadow); font-weight: 900;
    }
    .badge small { display: block; font-weight: 650; color: var(--muted); }
    .section { padding: 92px 0; }
    .section-head { max-width: 760px; margin-bottom: 34px; }
    .kicker { color: var(--purple); text-transform: uppercase; font-size: .8rem; letter-spacing: .13em; font-weight: 1000; }
    h2 { margin: 9px 0 14px; font-size: clamp(2.1rem, 4.5vw, 4.4rem); line-height: .98; letter-spacing: -.055em; }
    .section-head p { color: var(--muted); font-size: 1.06rem; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card {
      background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 26px; box-shadow: 0 12px 38px rgba(34,24,47,.06);
    }
    .num { font-size: .8rem; font-weight: 1000; color: var(--purple); letter-spacing: .12em; }
    .card h3 { font-size: 1.28rem; line-height: 1.15; letter-spacing: -.03em; margin: 12px 0 9px; }
    .card p { color: var(--muted); margin: 0; }
    .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: 42px; align-items: start; }
    .quote {
      position: sticky; top: 24px; background: linear-gradient(145deg, #161019, #251335); color: #fff;
      border-radius: 28px; padding: 34px; box-shadow: var(--shadow); overflow: hidden;
    }
    .quote::before { content: "“"; position: absolute; right: 18px; top: -22px; font-size: 10rem; color: rgba(152,82,255,.17); font-weight: 1000; line-height: 1; }
    .quote p { font-size: 1.45rem; line-height: 1.3; letter-spacing: -.03em; margin: 0 0 18px; max-width: 26ch; position: relative; }
    .quote small { color: #c9bdd2; }
    .steps { display: grid; gap: 12px; }
    .step { display: grid; grid-template-columns: 52px 1fr; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid var(--line); }
    .step-icon { width: 52px; height: 52px; border-radius: 16px; background: var(--purple-soft); color: var(--purple); display: grid; place-items: center; font-weight: 1000; }
    .step h3 { margin: 2px 0 5px; letter-spacing: -.025em; }
    .step p { margin: 0; color: var(--muted); }
    .details {
      border: 1px solid var(--line); border-radius: 28px; background: var(--surface); padding: 30px;
    }
    .gumroad-description { color: var(--muted); }
    .gumroad-description p:first-child { margin-top: 0; }
    .rating-line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
    .stars { letter-spacing: .08em; color: var(--purple); }
    .final {
      margin: 82px auto 120px; padding: 56px; border-radius: 34px; overflow: hidden;
      background: linear-gradient(135deg, #140c1e, #2a1241 58%, #39136a); color: #fff;
      box-shadow: 0 30px 90px rgba(37,13,61,.30); position: relative;
    }
    .final::after { content: ""; position: absolute; width: 340px; height: 340px; right: -120px; top: -160px; border-radius: 50%; background: rgba(160,96,255,.19); }
    .final h2 { max-width: 12ch; margin-top: 0; }
    .final p { max-width: 620px; color: #d9cfe2; font-size: 1.08rem; }
    .final .buy { background: #fff; color: #29143c; box-shadow: none; }
    .footer { padding: 0 0 110px; color: var(--muted); font-size: .86rem; text-align: center; }
    .mobile-buy { display: none; }
    :focus-visible { outline: 3px solid var(--purple-2); outline-offset: 3px; }
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; gap: 26px; padding-top: 42px; }
      .hero-copy { order: 1; }
      .book-stage { order: 2; min-height: 480px; }
      h1 { max-width: 10ch; }
      .grid { grid-template-columns: 1fr 1fr; }
      .split { grid-template-columns: 1fr; }
      .quote { position: relative; top: auto; }
    }
    @media (max-width: 620px) {
      .wrap { width: min(100% - 28px, 1160px); }
      .nav { padding-top: 16px; }
      .nav-cta { display: none; }
      .hero { padding: 36px 0 58px; min-height: auto; }
      h1 { font-size: clamp(3.05rem, 17vw, 5rem); }
      .lead { font-size: 1.05rem; }
      .book-stage { min-height: 410px; }
      .book { width: min(300px, 82%); }
      .badge { right: -6px; bottom: 4%; }
      .section { padding: 68px 0; }
      .grid { grid-template-columns: 1fr; }
      .card { padding: 22px; }
      .final { margin: 56px auto 96px; padding: 34px 24px; border-radius: 26px; }
      .footer { padding-bottom: 100px; }
      .mobile-buy {
        display: flex; position: fixed; z-index: 50; left: 10px; right: 10px; bottom: 10px;
        align-items: center; justify-content: space-between; gap: 12px; padding: 10px;
        background: color-mix(in srgb, var(--surface-solid) 92%, transparent); border: 1px solid var(--line);
        border-radius: 18px; box-shadow: 0 16px 48px rgba(0,0,0,.22); backdrop-filter: blur(16px);
      }
      .mobile-buy .buy { min-height: 46px; padding: 0 17px; border-radius: 13px; }
      .mobile-buy .price { font-size: 1.03rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">Aller au contenu</a>

  <header class="wrap nav" aria-label="Navigation principale">
    <div class="brand"><span class="brand-dot" aria-hidden="true"></span>ATKMusic</div>
    <button class="nav-cta" type="button" data-gumroad-action="buy">Obtenir le guide</button>
  </header>

  <main id="main">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Guide PDF · Débutant · 72 pages</div>
        <h1 id="hero-title"><span data-gumroad-field="name">Mon Premier Home Studio</span><span class="accent">.</span></h1>
        <p class="lead">Monte un home studio cohérent, fais une première prise propre et évite de jeter ton argent dans du matériel dont tu n’as pas encore besoin.</p>

        <ul class="bullets" aria-label="Ce que tu vas obtenir">
          <li><span class="check" aria-hidden="true">✓</span><span>Les achats vraiment utiles — et ceux que tu peux repousser.</span></li>
          <li><span class="check" aria-hidden="true">✓</span><span>Une méthode claire pour micro, interface, casque, branchements et logiciel.</span></li>
          <li><span class="check" aria-hidden="true">✓</span><span>3 setups selon ton budget + une checklist pratique pour passer à l’action.</span></li>
        </ul>

        <div class="buy-row">
          <button class="buy" type="button" data-gumroad-action="buy">Je construis mon home studio</button>
          <div class="price-note" aria-label="Prix du produit">
            <span class="price" data-gumroad-field="price">Prix accessible</span>
            <span class="micro">Paiement sécurisé via Gumroad · accès au PDF après achat</span>
          </div>
        </div>

        <div class="trust" aria-label="Informations produit">
          <span>◉ PDF instantané</span>
          <span>◉ Lecture mobile</span>
          <span>◉ Sans jargon inutile</span>
        </div>
      </div>

      <div class="book-stage" aria-label="Aperçu de la couverture du guide">
        <div class="glow" aria-hidden="true"></div>
        <div class="book">
          <img class="cover" src="data:image/webp;base64," alt="Couverture de Mon Premier Home Studio par ATKMusic" width="679" height="960">
          <div class="badge"><small>Guide complet</small>72 pages</div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="section-head">
          <div class="kicker">À l’intérieur</div>
          <h2 id="inside-title">Du premier achat à ta première vraie prise.</h2>
          <p>Pas un catalogue de matériel : un parcours pensé pour comprendre ce dont tu as besoin, installer ton espace et enregistrer sans te perdre.</p>
        </div>
        <div class="grid">
          <article class="card"><div class="num">01</div><h3>Choisir sans surpayer</h3><p>Micro, interface, casque ou enceintes : apprends à prioriser selon ton usage réel.</p></article>
          <article class="card"><div class="num">02</div><h3>Installer ton espace</h3><p>Placement, acoustique de base et réflexes simples pour obtenir un son plus propre chez toi.</p></article>
          <article class="card"><div class="num">03</div><h3>Tout brancher</h3><p>Comprends la chaîne du signal, le 48V, le gain, le monitoring et la latence sans prise de tête.</p></article>
          <article class="card"><div class="num">04</div><h3>Régler ton logiciel</h3><p>Entrées, sorties, piste d’enregistrement et organisation : les bases qui évitent 80 % des galères.</p></article>
          <article class="card"><div class="num">05</div><h3>Prendre une voix propre</h3><p>Distance, anti-pop, niveau d’entrée et prise test : une méthode simple avant même de parler de mix.</p></article>
          <article class="card"><div class="num">06</div><h3>Adapter à ton budget</h3><p>Trois setups progressifs et une checklist finale pour acheter dans le bon ordre.</p></article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-title">
      <div class="wrap split">
        <aside class="quote">
          <p>Ton premier home studio n’a pas besoin d’être impressionnant. Il doit te permettre d’enregistrer.</p>
          <small>La philosophie du guide ATKMusic</small>
        </aside>
        <div>
          <div class="section-head">
            <div class="kicker">Pourquoi ce guide</div>
            <h2 id="why-title">Commence simple. Progresse quand une vraie limite apparaît.</h2>
          </div>
          <div class="steps">
            <div class="step"><div class="step-icon">1</div><div><h3>Évite les achats “studio de rêve”</h3><p>Tu n’as pas besoin d’une chaîne hors de prix pour apprendre à faire de bonnes prises.</p></div></div>
            <div class="step"><div class="step-icon">2</div><div><h3>Comprends ce que tu fais</h3><p>Le guide explique le rôle de chaque élément pour que ton setup ait du sens, au lieu d’empiler du matériel.</p></div></div>
            <div class="step"><div class="step-icon">3</div><div><h3>Fais de la musique plus vite</h3><p>Le but final n’est pas de collectionner des plugins : c’est de pouvoir brancher, enregistrer, écouter et recommencer.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="details-title">
      <div class="wrap">
        <div class="section-head">
          <div class="kicker">Détails Gumroad</div>
          <h2 id="details-title">Tout ce qu’il faut savoir avant d’acheter.</h2>
        </div>
        <div class="details">
          <div class="gumroad-description" data-gumroad-field="description">Guide PDF en français pour construire ton premier home studio de manière simple, cohérente et économique.</div>
          <div class="rating-line" aria-label="Avis clients">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <strong data-gumroad-field="rating">Nouveau</strong>
            <span class="micro" data-gumroad-field="review-count">Sois le premier à donner ton avis</span>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap final" aria-labelledby="final-title">
      <div class="kicker" style="color:#cba7ff">Prêt à enregistrer ?</div>
      <h2 id="final-title">Arrête de chercher le setup parfait.</h2>
      <p>Prends une méthode claire, construis un setup qui te ressemble et concentre-toi sur la seule chose qui compte vraiment : faire de la musique.</p>
      <div class="buy-row" style="margin-top:26px">
        <button class="buy" type="button" data-gumroad-action="buy">Obtenir le guide maintenant</button>
        <div class="price-note"><span class="price" data-gumroad-field="price">Prix accessible</span><span class="micro" style="color:#c9bdd2">Téléchargement après achat</span></div>
      </div>
    </section>
  </main>

  <footer class="wrap footer">ATKMusic · Mon Premier Home Studio · Produit numérique livré par Gumroad.</footer>

  <div class="mobile-buy" aria-label="Acheter le guide">
    <div class="price-note"><span class="micro">Le guide complet</span><span class="price" data-gumroad-field="price">Prix accessible</span></div>
    <button class="buy" type="button" data-gumroad-action="buy">Acheter</button>
  </div>

  <script is:inline>
    const gumroadUrl = "https://atkmusic.gumroad.com/l/mon-premier-home-studio";
    document.querySelectorAll('[data-gumroad-action="buy"]').forEach((button) => {
      button.addEventListener('click', () => {
        window.open(gumroadUrl, '_blank', 'noopener');
      });
    });
  </script>

<noscript><p style="text-align:center;padding:16px"><a href="https://atkmusic.gumroad.com/l/mon-premier-home-studio">Acheter le guide sur Gumroad</a></p></noscript>
</body>
</html>
